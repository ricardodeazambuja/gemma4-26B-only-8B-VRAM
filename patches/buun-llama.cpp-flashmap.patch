+    void set_input(const llama_ubatch * ubatch) override {
+        GGML_ASSERT(ubatch && ubatch->pos && (int64_t) ubatch->n_tokens > n_inj);
+        // the anchor is the first block row, after any fused-inject rows
+        const llama_pos anchor = ubatch->pos[n_inj];
+        std::vector<int32_t> pos(n_slot);
+        for (int64_t i = 0; i < n_slot; ++i) {
+            pos[i] = anchor + 1 + (int32_t) i;
+        }
+        ggml_backend_tensor_set(slot_pos, pos.data(), 0, pos.size() * sizeof(int32_t));
+
+        static thread_local std::mt19937 rng([] {
+            const char * e = getenv("GGML_FLASHMAP_SEED");
+            return e ? (uint32_t) atoi(e) : 0x5eedu;
+        }());
+        std::normal_distribution<float> normal;
+        z.resize(ggml_nelements(noise));
+        for (auto & v : z) {
+            v = normal(rng);
+        }
+        ggml_backend_tensor_set(noise, z.data(), 0, z.size() * sizeof(float));
+    }
+
+    bool can_reuse(const llm_graph_params & params) override {
+        const int64_t n_inj_now = params.cparams.dflash_oneg_stage ? params.cparams.dflash_oneg_n_inject : 0;
+        return n_inj_now == n_inj;
+    }
+
+    ggml_tensor * slot_pos = nullptr; // I32 [n_slot]
+    ggml_tensor * noise    = nullptr; // F32 [n_embd_tgt, n_slot]
+
+    const int64_t n_slot;
+    const int64_t n_inj;
+    std::vector<float> z;
+};
+
+// FlashMap draft decode: a DiT that jumps from noise to the whole block in one step.
+// Ubatch layout: [fused-inject rows,] anchor, placeholders. The context rows (inject
+// rows + the anchor's embedding) go to the drafter KV cache as cross-attention K/V; the
+// block's slots sit at anchor + 1 .. anchor + n_slot and output row i is slot i, the
+// draft for position anchor + 1 + i (the DSpark anchor-first contract).
+static void build_flashmap_draft(llm_graph_context & g, const llama_model & model,
+        ggml_tensor * inp_pos, llm_graph_input_attn_kv * inp_attn) {
+    ggml_context * ctx0 = g.ctx0;
+    const auto & hparams = g.hparams;
+    const auto & cparams = g.cparams;
+
+    const int64_t n_embd_tgt = hparams.flashmap_n_embd_tgt;
+    const int64_t n_head     = hparams.n_head();
+    const int64_t n_head_kv  = hparams.n_head_kv();
+    const int64_t n_hd       = hparams.n_embd_head_k();
+    const int64_t n_tok      = g.n_tokens;
+    const int64_t n_inj      = cparams.dflash_oneg_stage ? cparams.dflash_oneg_n_inject : 0;
+    const int64_t n_out      = n_tok - n_inj;
+    GGML_ASSERT(n_out > 0);
+    // a draft is one trained block; only worst-case graph reservation builds a wider ubatch
+    const int64_t n_slot     = std::max<int64_t>(hparams.dflash_block_size, n_out);
+    GGML_ASSERT(!inp_attn->self_k_rot && !inp_attn->self_v_rot && "FlashMap drafter KV cache must not be rotated");
+
+    const float eps_rms  = hparams.f_norm_rms_eps;
+    const float eps_qk   = hparams.flashmap_qk_norm_eps;
+    const float kq_scale = 1.0f / sqrtf(float(n_hd));
+
+    auto rms = [&](ggml_tensor * x, ggml_tensor * w, float eps) {
+        return ggml_mul(ctx0, ggml_rms_norm(ctx0, x, eps), w);
+    };
+    auto linear = [&](ggml_tensor * w, ggml_tensor * b, ggml_tensor * x) {
+        ggml_tensor * y = g.build_lora_mm(w, x);
+        return b ? ggml_add(ctx0, y, b) : y;
+    };
+    auto rope = [&](ggml_tensor * x, ggml_tensor * pos) {
+        return ggml_rope_ext(ctx0, x, pos, nullptr, g.n_rot, g.rope_type, g.n_ctx_orig,
+                g.freq_base, g.freq_scale, g.ext_factor, g.attn_factor, g.beta_fast, g.beta_slow);
+    };
+    // AdaLN with the jump's baked modulation: LayerNorm(x) * (1 + scale) + shift
+    auto adaln = [&](ggml_tensor * x, ggml_tensor * mod, ggml_tensor * mod_b, int il) {
+        return g.build_norm(x, mod, mod_b, LLM_NORM, il);
+    };
+
+    const llama_model * model_tgt = cparams.ctx_other ? llama_get_model(cparams.ctx_other) : nullptr;
+    ggml_tensor * tok_embd = model.tok_embd ? model.tok_embd : model_tgt ? model_tgt->tok_embd : nullptr;
+    GGML_ASSERT(tok_embd && "FlashMap drafter requires the target model's token embeddings");
+
+    auto inp = std::make_unique<llm_graph_input_embd>(hparams.n_embd);
+    inp->tokens = ggml_new_tensor_1d(ctx0, GGML_TYPE_I32, n_tok);
+    ggml_set_input(inp->tokens);
+    g.res->t_inp_tokens = inp->tokens;
+    ggml_tensor * block_tokens = n_inj > 0
+        ? ggml_view_1d(ctx0, inp->tokens, n_out, size_t(n_inj) * inp->tokens->nb[0])
+        : inp->tokens;
+    g.res->add_input(std::move(inp));
+
+    // context rows of this decode. Only the anchor's (the first block row's) is ever
+    // attended: every slot uses the anchor row's mask, which hides the placeholder rows.
+    ggml_tensor * ctx_rows = g.build_get_rows_embd(tok_embd, block_tokens);
+    ctx_rows = linear(model.flashmap_anchor_proj, model.flashmap_anchor_proj_b, ctx_rows);
+    ctx_rows = rms(ctx_rows, model.flashmap_anchor_norm, eps_rms);
+    g.cb(ctx_rows, "fm_anchor_ctx", -1);
+    if (n_inj > 0) {
+        ctx_rows = ggml_concat(ctx0, build_dflash_staged_enc(g, model, cparams.dflash_oneg_stage, n_inj), ctx_rows, 1);
+    }
+
+    auto inp_fm = std::make_unique<llm_graph_input_flashmap>(n_slot, n_inj);
+    inp_fm->slot_pos = ggml_new_tensor_1d(ctx0, GGML_TYPE_I32, n_slot);
+    ggml_set_input(inp_fm->slot_pos);
+    inp_fm->noise = ggml_new_tensor_2d(ctx0, GGML_TYPE_F32, n_embd_tgt, n_slot);
+    ggml_set_input(inp_fm->noise);
+    ggml_tensor * slot_pos = inp_fm->slot_pos;
+    ggml_tensor * noise    = inp_fm->noise;
+    g.res->add_input(std::move(inp_fm));
+
+    // one-step state: the embedded uniform posterior plus the gated, normed noise
+    ggml_tensor * x = ggml_mul_mat(ctx0, model.flashmap_noise_factor, noise);
+    x = rms(x, model.flashmap_noise_norm, eps_rms);
+    x = ggml_add(ctx0, x, model.flashmap_state_const);
+    ggml_tensor * h = linear(model.flashmap_x_embed, model.flashmap_x_embed_b, x);
+    g.cb(h, "fm_x_embed", -1);
+
+    // cross-attention mask: the anchor row's KV mask (context cells at or before the anchor
+    // in its sequence) for every slot
+    ggml_tensor * kq_mask = inp_attn->get_kq_mask();
+    GGML_ASSERT(kq_mask->ne[2] == 1 && kq_mask->ne[3] == 1);
+    ggml_tensor * ca_mask = ggml_view_2d(ctx0, kq_mask, kq_mask->ne[0], 1, kq_mask->nb[1], size_t(n_inj) * kq_mask->nb[1]);
+    ca_mask = ggml_cast(ctx0, ca_mask, GGML_TYPE_F32);
+    ca_mask = ggml_repeat(ctx0, ca_mask, ggml_new_tensor_2d(ctx0, GGML_TYPE_F32, kq_mask->ne[0], n_slot));
+    if (kq_mask->type != GGML_TYPE_F32) {
+        ca_mask = ggml_cast(ctx0, ca_mask, kq_mask->type);
+    }
+
+    for (int il = 0; il < g.n_layer; ++il) {
+        const auto & layer = model.layers[il];
+
+        // this decode's context rows -> drafter KV cache
+        {
+            ggml_tensor * Kc = g.build_lora_mm(layer.wk, ctx_rows);
+            ggml_tensor * Vc = g.build_lora_mm(layer.wv, ctx_rows);
+            Kc = ggml_reshape_3d(ctx0, Kc, n_hd, n_head_kv, n_tok);
+            Vc = ggml_reshape_3d(ctx0, Vc, n_hd, n_head_kv, n_tok);
+            Kc = rope(rms(Kc, layer.attn_k_norm, eps_qk), inp_pos);
+            g.build_attn(inp_attn, nullptr, nullptr, nullptr, nullptr, Kc, Vc, nullptr, nullptr, nullptr,
+                    kq_scale, il, nullptr, /*kv_only=*/ true);
+        }
+
+        // self-attention across the slots (non-causal)
+        {
+            ggml_tensor * cur = adaln(h, layer.fm_sa_mod, layer.fm_sa_mod_b, il);
+            ggml_tensor * Q = ggml_reshape_3d(ctx0, g.build_lora_mm(layer.fm_sa_q, cur), n_hd, n_head, n_slot);
+            ggml_tensor * K = ggml_reshape_3d(ctx0, g.build_lora_mm(layer.fm_sa_k, cur), n_hd, n_head, n_slot);
+            ggml_tensor * V = ggml_reshape_3d(ctx0, g.build_lora_mm(layer.fm_sa_v, cur), n_hd, n_head, n_slot);
+            Q = rope(rms(Q, layer.fm_sa_q_norm, eps_qk), slot_pos);
+            K = rope(rms(K, layer.fm_sa_k_norm, eps_qk), slot_pos);
+            cur = g.build_attn_mha(Q, K, V, nullptr, nullptr, nullptr, nullptr, 0, kq_scale, il);
+            cur = g.build_lora_mm(layer.fm_sa_out, cur);
+            h = ggml_add(ctx0, h, ggml_mul(ctx0, cur, layer.fm_sa_gate));
+            g.cb(h, "fm_self_out", il);
+        }
+
+        // cross-attention to the cached context
+        {
+            ggml_tensor * cur = adaln(h, layer.fm_ca_mod, layer.fm_ca_mod_b, il);
+            ggml_tensor * Q = ggml_reshape_3d(ctx0, g.build_lora_mm(layer.wq, cur), n_hd, n_head, n_slot);
+            Q = rope(rms(Q, layer.attn_q_norm, eps_qk), slot_pos);
+            ggml_tensor * K = inp_attn->mctx->get_k(ctx0, il);
+            ggml_tensor * V = inp_attn->mctx->get_v(ctx0, il);
+            cur = g.build_attn_mha(Q, K, V, nullptr, ca_mask, nullptr, nullptr, 0, kq_scale, il);
+            cur = g.build_lora_mm(layer.wo, cur);
+            h = ggml_add(ctx0, h, ggml_mul(ctx0, cur, layer.fm_ca_gate));
+            g.cb(h, "fm_cross_out", il);
+        }
+
+        // MLP (exact GELU)
+        {
+            ggml_tensor * cur = adaln(h, layer.fm_mlp_mod, layer.fm_mlp_mod_b, il);
+            cur = ggml_gelu_erf(ctx0, linear(layer.ffn_up, layer.ffn_up_b, cur));
+            cur = linear(layer.ffn_down, layer.ffn_down_b, cur);
+            h = ggml_add(ctx0, h, ggml_mul(ctx0, cur, layer.fm_mlp_gate));
+            g.cb(h, "l_out", il);
+        }
+    }
+
+    h = adaln(h, model.flashmap_final_mod, model.flashmap_final_mod_b, -1);
+    h = linear(model.flashmap_head, model.flashmap_head_b, h); // into the target's hidden space
+    if (n_out < n_slot) {
+        h = ggml_view_2d(ctx0, h, n_embd_tgt, n_out, h->nb[1], 0);
+    }
+    g.cb(h, "result_norm", -1);
+    g.res->t_embd = h;
+
+    // the target's lm_head
+    ggml_tensor * output      = model.output;
+    ggml_tensor * output_s    = model.output_s;
+    ggml_tensor * output_in_s = model.output_in_s;
+    if (output == nullptr) {
+        GGML_ASSERT(model_tgt && model_tgt->output != nullptr && "FlashMap drafter requires the target model's output projection");
+        output      = model_tgt->output;
+        output_s    = model_tgt->output_s;
+        output_in_s = model_tgt->output_in_s;
+    }
+    ggml_tensor * cur = g.build_lora_mm(output, h, output_s, output_in_s);
+    g.cb(cur, "result_output", -1);
+    g.res->t_logits = cur;
+    ggml_build_forward_expand(g.gf, cur);
+
+    build_dflash_draft_argmax(g);
+}
